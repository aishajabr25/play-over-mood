rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'aisha.jabr.3aosh@gmail.com';
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /mails/{uid} {
      allow read: if isAdmin();
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 100;
    }

    match /days/{dayId} {
      allow read: if isAdmin();
      allow get: if request.auth != null
        && dayId.matches(request.auth.uid + '_.*');
      allow write: if request.auth != null
        && dayId == request.auth.uid + '_' + request.resource.data.date
        && request.resource.data.uid == request.auth.uid;
    }

    match /weeks/{week}/players/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.points is number
        && request.resource.data.points <= 300;
    }

    match /stats/{week}/shards/{shard} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500;
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
    }

    match /meta/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /missionProgress/{docId} {
      allow read: if isAdmin();
      allow write: if request.auth != null
        && docId == request.resource.data.week + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    match /missionHistory/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /features/{featureId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 300;
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
    }

    match /customHabits/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /reflections/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && docId == request.resource.data.week + '_' + request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 600;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    match /announcementReactions/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && docId == request.resource.data.annId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    match /procrastinations/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /photos/{photoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.imageUrl is string;
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    match /featureLikes/{likeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && likeId == request.resource.data.featureId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
